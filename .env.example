DB_SERVER=192.250.231.34
DB_DATABASE=arkinfo1_flythai
DB_USER=arkinfo1_flythaiuser
DB_PASSWORD=

# Groq (https://console.groq.com/keys) - free tier, open-source models.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

PORT=3500

# --- Live booking-creation API (flythai.arkinfosoft.in) ---
# Capture via F12 -> Network -> Copy as cURL on Add Booking, then paste the Cookie header value here.
FLYTHAI_BASE_URL=https://flythai.arkinfosoft.in
FLYTHAI_SESSION_COOKIE=

# Shared secret for the signed chatbot-login token (src/chatbotKeyToken.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# FlyThai's .NET side must be configured with this exact same value once it generates tokens.
CHATBOT_KEY_SECRET=
